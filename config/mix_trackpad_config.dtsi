/*
 * Tunable parameters for Mix keyboard trackpad configuration.
 * Adjust these values to change mouse and scroll behavior.
 *
 * Format: NUMERATOR / DENOMINATOR
 *   Higher ratio = faster movement
 *   Lower ratio = slower, more precise movement
 */

/* Scroll layers: which layers activate scroll mode */
#define MIX_SCROLL_LAYERS 1 2 3

/* Cirque trackpad sensitivity: "1x" (default), "2x", "4x" */
#define MIX_CIRQUE_SENSITIVITY "2x"

/* Mouse pointer speed: 5/2 (@1x default), 5/2 (@2x fast), 3/1 (very fast) */
#define MIX_MOUSE_SPEED_NUM 5
#define MIX_MOUSE_SPEED_DEN 2

/* Scroll speed: 1/6 (default @1x), 1/30 (@2x slow), 1/20 (@2x medium) */
#define MIX_SCROLL_SPEED_NUM 1
#define MIX_SCROLL_SPEED_DEN 30

/* Edge scroll speed (scroll-enable): 1/3 (3x slower than the chip), 1/1 (as reported by the chip) */
#define MIX_EDGE_SCROLL_SPEED_NUM 1
#define MIX_EDGE_SCROLL_SPEED_DEN 3

/* Edge scroll direction: INPUT_TRANSFORM_Y_INVERT (same as layer scroll, natural), 0 (as reported by the chip) */
#define MIX_EDGE_SCROLL_TRANSFORM INPUT_TRANSFORM_Y_INVERT
